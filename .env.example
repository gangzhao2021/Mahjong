# Copy to .env (docker compose) or apps/server/.env (pnpm server) and fill in.
# Never commit the real .env.

# --- Required in production ---------------------------------------------------
# Database password for docker-compose.yml (the server's DATABASE_URL is built from it there).
POSTGRES_PASSWORD=change-me
# 32+ random characters each, e.g. `openssl rand -hex 32`. Keep them stable: changing
# SESSION_SECRET signs everyone out, changing ID_HASH_SECRET breaks phone / ID lookups.
SESSION_SECRET=
ID_HASH_SECRET=
# global or china
REGION=global
# Behind a reverse proxy / load balancer (needed for real client IPs in logs and the admin allowlist).
TRUST_PROXY=1

# --- AI dialogue (optional: without it the AI uses template lines) ----------
# Global build: Claude. Check it with `pnpm llm:smoke`.
ANTHROPIC_API_KEY=
# China build: a filed domestic model behind an OpenAI-compatible API (default DashScope / Qwen).
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_ROUTINE=qwen-turbo
# LLM_MODEL_HIGH=qwen-plus

# --- Admin dashboard (off unless all three are set; generate with `pnpm admin:setup`) ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Comma-separated IPs allowed to reach /admin (recommended).
ADMIN_IP_ALLOWLIST=

# --- Sign-in providers ----------------------------------------------------------
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_IDS=
# China build only
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- Log retention in days (China: login and chat logs never below 180) -------
# RETENTION_CHAT_DAYS=90
# RETENTION_LOGIN_DAYS=90
# RETENTION_CRASH_DAYS=90
# RETENTION_HAND_LOG_DAYS=180
