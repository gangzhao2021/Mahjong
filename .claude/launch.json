{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@mahjong/server",
        "start"
      ],
      "port": 8787
    },
    {
      "name": "server-china",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@mahjong/server",
        "start"
      ],
      "port": 8787,
      "env": {
        "REGION": "china",
        "DATA_DIR": "data-china"
      }
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081",
        "--offline"
      ],
      "port": 8081,
      "env": {
        "CI": "1"
      }
    },
    {
      "name": "mobile-web-8082",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8082",
        "--offline"
      ],
      "port": 8082,
      "env": {
        "CI": "1"
      }
    }
  ]
}
